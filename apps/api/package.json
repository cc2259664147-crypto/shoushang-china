{
  "name": "@shoushang/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@shoushang/contracts": "workspace:*",
    "fastify": "5.6.2"
  },
  "devDependencies": {
    "esbuild": "0.25.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=esm --external:fastify --outfile=dist/server.js",
    "start": "node dist/server.js"
  }
}
