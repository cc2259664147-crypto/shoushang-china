{
  "name": "shoushang-china",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n web,api \"pnpm --filter @shoushang/web dev\" \"pnpm --filter @shoushang/api dev\"",
    "build": "pnpm typecheck && pnpm --filter @shoushang/web build && pnpm --filter @shoushang/api build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/contracts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:delivery": "tsx scripts/content/verify-v1-initializer.ts",
    "content:initialize": "tsx scripts/content/initialize-v1.ts",
    "check:runtime": "node scripts/check-runtime.mjs",
    "m02:dev": "pnpm --filter @shoushang/papercut-verification dev",
    "m02:typecheck": "pnpm --filter @shoushang/papercut-verification typecheck",
    "m02:test": "pnpm --filter @shoushang/papercut-verification test",
    "m02:build": "pnpm --filter @shoushang/papercut-verification build",
    "m03:dev": "pnpm --filter @shoushang/ui-preview dev",
    "m03:typecheck": "pnpm --filter @shoushang/ui-preview typecheck",
    "m03:test": "pnpm --filter @shoushang/ui-preview test",
    "m03:build": "pnpm --filter @shoushang/ui-preview build",
    "m03": "pnpm m03:dev",
    "m04:typecheck": "tsc --noEmit -p packages/papercut-core/tsconfig.json",
    "m04:test": "vitest run packages/papercut-core/src/core.test.ts",
    "m04": "pnpm m04:typecheck && pnpm m04:test",
    "m05:dev": "pnpm --filter @shoushang/storage-verification dev",
    "m05:typecheck": "pnpm --filter @shoushang/storage-verification typecheck",
    "m05:test": "pnpm --filter @shoushang/storage-verification test",
    "m05:build": "pnpm --filter @shoushang/storage-verification build"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@shoushang/contracts": "workspace:*",
    "@shoushang/fixtures": "workspace:*",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "concurrently": "9.2.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
