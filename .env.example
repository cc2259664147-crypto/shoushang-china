# Copy values into the launching shell. pnpm/Node do not automatically load this file.
# Database, media and backups must live in a private directory outside this project.
# Replace the placeholder with an absolute path on your machine before starting.
CONTENT_DATABASE_PATH=C:/private/shoushang-demo/content.sqlite
HOST=127.0.0.1
PORT=3001
API_PROXY_TARGET=http://127.0.0.1:3001

# Admin is OFF unless explicitly enabled. Use new private directories outside apps/web.
# These example values are not loaded automatically by pnpm/Node.
# ADMIN_ENABLED=1
# Public referenced images also use this root when ADMIN_ENABLED=0.
# ADMIN_MEDIA_ROOT=C:/private/shoushang-dev/media
# When enabled, CONTENT_DATABASE_PATH must be an absolute private path outside this project.
# ADMIN_SECURITY_MODE=loopback-http
# ADMIN_ORIGIN=http://127.0.0.1:5173
# ADMIN_BACKUP_ROOT=C:/private/shoushang-dev/backups
# For HTTPS deployment, set ADMIN_SECURITY_MODE=https and an exact HTTPS ADMIN_ORIGIN.
